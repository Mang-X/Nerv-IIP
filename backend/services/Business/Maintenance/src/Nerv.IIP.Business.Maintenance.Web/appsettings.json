{
  "Persistence": {
    "AutoMigrate": false
  },
  "Messaging": {
    "Provider": "InMemory"
  },
  "Maintenance": {
    "RestorePrediction": {
      "DefaultDowntimeMinutes": 60
    },
    "DowntimeEscalation": {
      "Threshold": "02:00:00",
      "ScanInterval": "00:05:00",
      "Scopes": []
    }
  },
  "AllowedHosts": "*"
}
