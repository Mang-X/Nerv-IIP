{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Messaging": {
    "Provider": "InMemory"
  },
  "Quality": {
    "CapaAutomation": {
      "Enabled": true,
      "MinimumSeverity": "major",
      "Dispositions": [
        "rework",
        "scrap"
      ],
      "OwnerUserId": "system:quality",
      "DueDays": 14
    },
    "CapaCloseApproval": {
      "Required": false
    },
    "MeasuringDevice": {
      "CalibrationScanEnabled": false,
      "ExpiredInspectionPolicy": "warn"
    },
    "PeriodicInspectionTime": {
      "Enabled": false,
      "Interval": "00:15:00",
      "MaxWindowsPerContext": 24,
      "ContextBatchSize": 100,
      "Scopes": []
    }
  },
  "AllowedHosts": "*"
}
