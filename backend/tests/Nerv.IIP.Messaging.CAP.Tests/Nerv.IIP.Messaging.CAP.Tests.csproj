<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- #3222：真 Redis 回归要一个**真**的 CAP 存储端（真 outbox / 真 cap.received），
         否则「故障期间发布的消息恢复后不丢」只会证明夹具自洽。这两个包只在本测试项目使用，
         版本由 backend/Directory.Packages.props 统一钉住，不新增版本来源。 -->
    <PackageReference Include="DotNetCore.CAP.PostgreSql" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- #3739：死信列表的失败码与时间窗谓词由 EF 翻译成 SQL 执行，SQLite/InMemory 与 Npgsql
         的翻译与时间戳精度都不等价（timestamptz 只存到微秒）。要钉住生产实现就得在真 provider 上跑。 -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\common\Messaging\Nerv.IIP.Messaging.CAP\Nerv.IIP.Messaging.CAP.csproj" />
    <!-- #3249：恢复/停止的生命周期用例需要受治理的有界轮询原语（Eventually），不自建 sleep 循环。 -->
    <ProjectReference Include="..\..\common\Testing\Nerv.IIP.Testing\Nerv.IIP.Testing.csproj" />
    <ProjectReference Include="..\..\common\Messaging\Nerv.IIP.Messaging.CAP.EntityFrameworkCore\Nerv.IIP.Messaging.CAP.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\common\Contracts\Nerv.IIP.Contracts.IntegrationEvents\Nerv.IIP.Contracts.IntegrationEvents.csproj" />
    <!-- #3122：共享解析器与各事件族 ResolveSubscriptionTemplate 的差分测试需要这两族契约；
         这是测试项目的引用，共享基础设施本身不引任何领域契约。 -->
    <ProjectReference Include="..\..\common\Contracts\Nerv.IIP.Contracts.Maintenance\Nerv.IIP.Contracts.Maintenance.csproj" />
    <ProjectReference Include="..\..\common\Contracts\Nerv.IIP.Contracts.Mes\Nerv.IIP.Contracts.Mes.csproj" />
  </ItemGroup>
</Project>
