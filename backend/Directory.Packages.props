<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      传递依赖也受 PackageVersion 约束。不开这个属性时，PackageVersion 只管声明了直接
      PackageReference 的项目，凡是只经传递取得某个包的宿主都不受约束 —— NuGet 按「最低适用版本」
      解析到依赖方 nuspec 声明的下界。本仓已因此累计四次分叉（#3136 MediatR、#3152 与 #3157
      EF Core 与 FluentValidation.AspNetCore、#3237 DotNetCore.CAP 8.4.1），四次都是人工发现。
      开启后该类问题在构造上不再可能发生（关联 #3226）。
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="DotNetCore.CAP" Version="10.0.2" />
    <PackageVersion Include="DotNetCore.CAP.Dashboard" Version="10.0.2" />
    <PackageVersion Include="DotNetCore.CAP.PostgreSql" Version="10.0.2" />
    <PackageVersion Include="DotNetCore.CAP.RabbitMQ" Version="10.0.2" />
    <PackageVersion Include="DotNetCore.CAP.RedisStreams" Version="10.0.2" />
    <PackageVersion Include="FastEndpoints" Version="9.0.0" />
    <PackageVersion Include="FastEndpoints.Swagger" Version="9.0.0" />
    <PackageVersion Include="FastEndpoints.Swagger.Swashbuckle" Version="2.3.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.Redis.StackExchange" Version="1.12.0" />
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="tusdotnet" Version="2.12.0" />
    <PackageVersion Include="Minio" Version="7.0.0" />
    <PackageVersion Include="NetCorePal.Context.AspNetCore" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Context.CAP" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Context.Shared" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Extensions.AspNetCore" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Extensions.CodeAnalysis" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Extensions.DistributedTransactions.CAP.PostgreSQL" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Extensions.Domain.Abstractions" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Extensions.MicrosoftServiceDiscovery" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Extensions.MultiEnv" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Extensions.NewtonsoftJson" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Extensions.Primitives" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Extensions.DistributedLocks.Abstractions" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Extensions.Repository.EntityFrameworkCore" Version="3.4.0" />
    <PackageVersion Include="NetCorePal.Extensions.Repository.EntityFrameworkCore.Snowflake" Version="3.4.0" />
    <PackageVersion Include="Npgsql" Version="10.0.4" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageVersion Include="prometheus-net.AspNetCore.HealthChecks" Version="8.2.1" />
    <PackageVersion Include="Sep" Version="0.18.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.ClientInfo" Version="3.0.0" />
