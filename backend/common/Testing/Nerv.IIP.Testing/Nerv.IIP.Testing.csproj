<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetCore.CAP" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!--
      Eventually.AssertAsync retries assertion-shaped failures only, which means it has to recognise
      Xunit.Sdk.XunitException. Every consumer of this library is already an xUnit test project, so the
      dependency does not widen any boundary: no production assembly references Nerv.IIP.Testing.
    -->
    <PackageReference Include="xunit" />
  </ItemGroup>

</Project>
