    "@capacitor/status-bar": "8.0.4",
    "@lucide/vue": "1.77.0",
    "@nerv-iip/api-client": "workspace:*",
    "@nerv-iip/app-shell": "workspace:*",
    "@nerv-iip/auth": "workspace:*",
    "@nerv-iip/business-core": "workspace:*",
    "@nerv-iip/ui": "workspace:*",
    "@nerv-iip/ui-mobile": "workspace:*",
    "@pinia/colada": "1.4.9",
